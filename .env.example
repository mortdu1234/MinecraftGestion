# ---------- Pterodactyl ----------
PTERO_URL=https://panel.example.com
# Clé API *Client* (Compte > API Credentials), commence par ptlc_
PTERO_API_KEY=ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PTERO_VERIFY_TLS=true
# Vide = serveurs du compte | admin-all = tous les serveurs (clé d'un admin) | owner
PTERO_LIST_TYPE=
# Filtres optionnels (identifiants ou noms, séparés par des virgules)
SERVERS_INCLUDE=
SERVERS_EXCLUDE=

# ---------- Nextcloud ----------
NC_URL=https://cloud.example.com
NC_USER=backup
# Utilise un "mot de passe d'application" (Paramètres > Sécurité)
NC_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx
NC_BASE_PATH=Backups
NC_VERIFY_TLS=true
# Au-delà de ce seuil, upload par morceaux (chunked)
NC_CHUNK_THRESHOLD_MB=100
NC_CHUNK_SIZE_MB=100

# ---------- Sauvegardes ----------
# Nombre de backups conservés par serveur
BACKUP_KEEP=5
# Cron (minute heure jour mois jour_semaine) : ici tous les jours à 4h
BACKUP_CRON=0 4 * * *
TZ=Europe/Paris
RUN_ON_START=false
# Timeout de création d'un backup sur le panel (secondes)
BACKUP_TIMEOUT=3600
# false = supprime le backup du panel après l'envoi (libère le quota du serveur)
KEEP_PANEL_BACKUP=false
# true = dossier "Nom_identifiant" au lieu de "Nom" (évite les collisions de noms)
FOLDER_INCLUDE_ID=false
TMP_DIR=/tmp/backups
LOG_LEVEL=INFO
